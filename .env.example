# Local PostgreSQL. Credentials here are development defaults only.
DATABASE_URL=postgresql+asyncpg://souvenir:souvenir@127.0.0.1:5432/souvenir
# Set your agreed business conversion rate. Empty disables RUB price conversion.
# Example format: RUB_KZT_RATE=5.50 (illustration, not a current market quote)
RUB_KZT_RATE=
CACHE_TTL_SECONDS=3600
PROVIDER_TIMEOUT_SECONDS=240
PROVIDER_RETRIES=1
MAX_PAGES_PER_QUERY=2
MAX_PRODUCTS_PER_QUERY=12
MAX_ACTIVE_SEARCHES=4
# Research traverses to natural pagination exhaustion; legacy MAX_*_PER_QUERY limits do not apply.
RESEARCH_SUPPLIER_CONCURRENCY=2
RESEARCH_REQUEST_DELAY_SECONDS=0.8
RESEARCH_MAX_SECONDS=600
RESEARCH_BRANCH_SLICE_SECONDS=45
BACKGROUND_RESEARCH_ENABLED=true
OBSERVATION_REFRESH_MINUTES=1440
CATALOG_DISCOVERY_INTERVAL_HOURS=24
GLOBAL_RESEARCH_CONCURRENCY=2
PROVIDER_CONCURRENCY=1
RESEARCH_JOB_TIMEOUT_SECONDS=300
SCHEDULER_STAGGER_SECONDS=600
LLM_BACKEND=basic
# basic = explicit deterministic fallback; ollama / openai_compatible = local LLM.
LLM_BASE_URL=http://127.0.0.1:11434
LLM_MODEL=
LLM_TIMEOUT_SECONDS=60
LLM_STRUCTURED_RETRIES=1
MAX_TOOL_CALLS_PER_MESSAGE=5
AGENT_TIMEOUT_SECONDS=600
DEBUG_AGENT=false
API_HOST=127.0.0.1
API_PORT=8000
PRESENTATION_WORKER_ENABLED=true
PRESENTATION_TIMEOUT_SECONDS=300
PRESENTATION_QUEUE_LIMIT=12
# Empty uses the project's .local/presentations. Use persistent backend storage in deployment.
PRESENTATION_STORAGE=

AUTH_REQUIRED=true
AUTH_COOKIE_SECURE=false
VTO_PAGE_SIZE=20
VTO_REQUEST_DELAY_SECONDS=0.3
FULL_RECONCILIATION_DAYS=1
INCREMENTAL_SYNC_HOURS=24
